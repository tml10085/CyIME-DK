            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_sunset" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconThemeAurora"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_aurora" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
