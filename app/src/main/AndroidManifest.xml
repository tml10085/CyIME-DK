            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_mint" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconThemeCream"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_cream" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconThemeDesert"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_desert" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconThemeMono"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_mono" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name="com.kingzcheung.xime.CustomLayoutActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- 整屏实时字幕：常亮、横竖屏切换不重建（老人页面不能因为转屏丢字幕） -->
        <activity android:name="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:exported="false" android:launchMode="singleTask"
            android:taskAffinity="com.kingzcheung.xime.caption" android:label="字幕"
            android:icon="@mipmap/caption_launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Xime.Caption" />
        <!-- 桌面上单独的“字幕”图标：默认关闭，在“语音转文本 → 字幕”里打开（CaptionLauncherIcon） -->
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncher"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 字幕桌面入口的主题色版本：已打开字幕图标时，换主题只启用对应颜色的一个（CaptionLauncherIcon） -->
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherLavender"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_lavender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherSoftblue"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_softblue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherSakura"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_sakura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherSunset"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_sunset">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherAurora"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherMint"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_mint">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.ui.caption.CaptionLauncherCream"
            android:targetActivity="com.kingzcheung.xime.ui.caption.CaptionActivity"
            android:enabled="false" android:exported="true" android:label="字幕" android:icon="@mipmap/caption_launcher_cream">
            <intent-filter>
