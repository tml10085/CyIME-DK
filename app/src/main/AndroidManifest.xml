<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 通讯录插件：只在打开插件时申请，读到的只在内存里 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：把从 GitHub 下载的新版安装包交给系统安装程序（每次由用户确认）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
    <!-- 本应用组件统一使用全限定类名：applicationId（com.cyletix.cyime）与 namespace
         （com.kingzcheung.xime）不同，相对类名的解析结果取决于 AGP 版本，
         写全限定名可无歧义地指向实际类所在包。 -->
    <application
        android:name="com.kingzcheung.xime.XimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/cyime_launcher_facet"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/cyime_launcher_facet"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xime"
        tools:targetApi="31">
        
        <!-- Developer tool for test scripts (does nothing outside 装到我的设备 builds); only adb (DUMP) may send it. -->
        <receiver
            android:name="com.kingzcheung.xime.service.DevLearningReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.cyletix.cyime.DEV_LEARNING" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.kingzcheung.xime.service.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.kingzcheung.xime.clipboard.VerificationCodeSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- 同拍照识字：自己单独一个任务。原来落进设置那个任务，从键盘添加图片会把设置带到前台，
             选完图停在设置，不回当前输入框。 -->
        <activity android:name="com.kingzcheung.xime.clipboard.ImageAccessActivity"
            android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- 自己单独一个任务（taskAffinity 为空）：CyIME 设置开在后台时，拍照识字原来会落进设置那个任务，
             把设置带到前台、结束后停在设置，不回当前输入框（GitHub #64）。 -->
        <activity android:name="com.kingzcheung.xime.ocr.DocumentOcrActivity"
            android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name="com.kingzcheung.xime.ocr.OcrRecognitionService"
            android:exported="false" android:process=":ocr" />
        <!-- 主Activity -->
        <activity
            android:name="com.kingzcheung.xime.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:theme="@style/Theme.Xime">

            <!-- 接收其他应用分享的 .yaml / .zip 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconOriginal"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/cyime_launcher_facet" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconNeon"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_neon" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconGlass"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_glass" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFacet"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_facet" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
