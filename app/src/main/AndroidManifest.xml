            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconNeonBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_neon" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconGlassBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_glass" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFacetBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_facet" android:label="${appLabel}">
            <intent-filter>
