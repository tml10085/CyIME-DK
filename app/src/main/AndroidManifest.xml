            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- “桌面图标跟随主题色”：每个主题色一个入口，换主题时只启用对应的一个（IconAppearance.followTheme） -->
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconThemeLavender"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_theme_lavender" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
