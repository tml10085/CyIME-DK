                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 下拉快捷开关里的“字幕” -->
        <service android:name="com.kingzcheung.xime.ui.caption.CaptionTileService"
            android:exported="true" android:label="字幕" android:icon="@drawable/caption_launcher_foreground"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 输入法服务。名字直接写字面量：系统设置在应用更新途中读不到资源时会退回显示类名（2026-10-19 平板“默认键盘”显示成 XimeInputMethodService），打包器检查。 -->
        <service
            android:name="com.kingzcheung.xime.service.XimeInputMethodService"
            android:exported="true"
            android:label="${imeServiceLabel}"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        
        <!-- AI 模型推理服务（独立进程，crash 不影响 IME） -->
        <service
            android:name="com.kingzcheung.xime.service.InferenceService"
            android:exported="false"
            android:process=":inference" />
        
        <!-- 离线语音识别服务（独立进程，模型推理不占用输入法进程内存） -->
        <!-- 通话字幕：通话中只有无障碍服务能同时使用麦克风并在其他应用上方显示字幕 -->
        <service
            android:name="com.kingzcheung.xime.ui.caption.CallCaptionService"
            android:exported="true"
            android:label="@string/call_caption_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/call_caption_service" />
        </service>

        <service
            android:name="com.kingzcheung.xime.service.AsrInferenceService"
            android:exported="false"
            android:process=":asr" />
        
    </application>

</manifest>
